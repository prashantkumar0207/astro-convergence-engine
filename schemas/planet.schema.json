{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Planet Knowledge Schema",
    "description": "Canonical intrinsic planetary metadata for the Astro Convergence Engine.",
    "type": "object",
    "required": [
        "schema_version",
        "metadata",
        "planets"
    ],
    "properties": {
        "schema_version": {
            "type": "string"
        },
        "metadata": {
            "type": "object",
            "required": [
                "authority",
                "description",
                "version"
            ],
            "properties": {
                "authority": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "planets": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "enum",
                    "name",
                    "symbol",
                    "classification",
                    "attributes",
                    "karakas",
                    "references"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "enum": {
                        "type": "string"
                    },
                    "name": {
                        "type": "object",
                        "required": [
                            "english",
                            "sanskrit"
                        ],
                        "properties": {
                            "english": {
                                "type": "string"
                            },
                            "sanskrit": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    },
                    "symbol": {
                        "type": "string"
                    },
                    "classification": {
                        "type": "object",
                        "required": [
                            "category",
                            "gender",
                            "element",
                            "nature",
                            "guna",
                            "caste",
                            "direction",
                            "weekday"
                        ],
                        "properties": {
                            "category": {
                                "type": "string"
                            },
                            "gender": {
                                "type": "string"
                            },
                            "element": {
                                "type": "string"
                            },
                            "nature": {
                                "type": "string"
                            },
                            "guna": {
                                "type": "string"
                            },
                            "caste": {
                                "type": "string"
                            },
                            "direction": {
                                "type": "string"
                            },
                            "weekday": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    },
                    "attributes": {
                        "type": "object",
                        "properties": {
                            "luminary": {
                                "type": "boolean"
                            },
                            "visible": {
                                "type": "boolean"
                            },
                            "physical": {
                                "type": "boolean"
                            }
                        },
                        "additionalProperties": false
                    },
                    "karakas": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "references": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "source"
                            ],
                            "properties": {
                                "source": {
                                    "type": "string"
                                },
                                "chapter": {
                                    "type": "string"
                                },
                                "verse": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}