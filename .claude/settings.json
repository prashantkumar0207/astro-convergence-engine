{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git checkout -- *)",
      "Bash(git restore --staged*)",
      "Bash(python -m pytest*)",
      "Bash(python scripts/check_adr_numbering.py*)",
      "Bash(python scripts/check_retired_identifiers.py*)",
      "Bash(python scripts/check_identifier_families.py*)",
      "Bash(python scripts/check_artifact_drift.py*)",
      "Bash(python scripts/check_oracle_environment.py*)",
      "Bash(python validate_*.py*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh api repos/*/branches/*/protection)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/git_safety_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/governance_gate_check.py"
          }
        ]
      }
    ]
  }
}
